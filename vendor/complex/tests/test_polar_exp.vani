// Tests for modulus/argument/polar form, exponential/logarithm, and
// integer powers.
// Run with:  vanic test tests/test_polar_exp.vani

use "../src/lib.vani";

fn close(a: f64, b: f64) -> bool {
    return abs(a - b) < 1.0e-9;
}

fn main() -> i64 {
    // abs/arg of 3+4i (classic 3-4-5 triangle)
    let c34: Complex = complex_new(3.0, 4.0);
    assert close(complex_abs(c34), 5.0);
    assert close(complex_arg(c34), atan2(4.0, 3.0));

    // from_polar roundtrip: from_polar(abs(z), arg(z)) = z
    let rt: Complex = complex_from_polar(complex_abs(c34), complex_arg(c34));
    assert close(rt.re, 3.0);
    assert close(rt.im, 4.0);

    // Euler's identity: e^(i*pi) = -1
    let ipi: Complex = complex_new(0.0, f64_pi());
    let euler: Complex = complex_exp(ipi);
    assert close(euler.re, 0.0 - 1.0);
    assert abs(euler.im) < 1.0e-9;

    // log(exp(z)) = z (roundtrip)
    let z0: Complex = complex_new(1.5, 0.7);
    let roundtrip: Complex = complex_log(complex_exp(z0));
    assert close(roundtrip.re, 1.5);
    assert close(roundtrip.im, 0.7);

    // sqrt(-1) = i
    let neg1: Complex = complex_new(0.0 - 1.0, 0.0);
    let sqrt_neg1: Complex = complex_sqrt(neg1);
    assert close(sqrt_neg1.re, 0.0);
    assert close(sqrt_neg1.im, 1.0);

    // sqrt(z)^2 = z for an arbitrary z
    let z1: Complex = complex_new(5.0, 12.0);
    let sq: Complex = complex_sqrt(z1);
    let back: Complex = complex_mul(sq, sq);
    assert close(back.re, 5.0);
    assert close(back.im, 12.0);

    // i^2 = -1
    let iunit: Complex = complex_new(0.0, 1.0);
    let ip2: Complex = complex_pow_i64(iunit, 2);
    assert close(ip2.re, 0.0 - 1.0);
    assert close(ip2.im, 0.0);

    // i^4 = 1
    let ip4: Complex = complex_pow_i64(iunit, 4);
    assert close(ip4.re, 1.0);
    assert close(ip4.im, 0.0);

    // z^0 = 1
    let ip0: Complex = complex_pow_i64(z1, 0);
    assert close(ip0.re, 1.0);
    assert close(ip0.im, 0.0);

    // 2^-1 = 0.5 (negative integer power)
    let two: Complex = complex_new(2.0, 0.0);
    let inv2: Complex = complex_pow_i64(two, 0 - 1);
    assert close(inv2.re, 0.5);
    assert close(inv2.im, 0.0);

    // 4th roots of unity: 1, i, -1, -i
    let roots: Vec<Complex> = complex_nth_roots_of_unity(4);
    assert (len(roots) as i64) == 4;
    assert close(roots[0].re, 1.0);
    assert close(roots[0].im, 0.0);
    assert close(roots[1].re, 0.0);
    assert close(roots[1].im, 1.0);
    assert close(roots[2].re, 0.0 - 1.0);
    assert abs(roots[2].im) < 1.0e-9;
    assert abs(roots[3].re) < 1.0e-9;
    assert close(roots[3].im, 0.0 - 1.0);

    // Every n-th root of unity has modulus 1.
    let roots6: Vec<Complex> = complex_nth_roots_of_unity(6);
    let i: i64 = 0;
    while i < 6 {
        assert close(complex_abs(roots6[i]), 1.0);
        i = i + 1;
    }

    return 0;
}
