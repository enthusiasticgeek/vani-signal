// Tests for complex trigonometric and hyperbolic functions.
// Run with:  vanic test tests/test_trig.vani

use "../src/lib.vani";

fn close(a: f64, b: f64) -> bool {
    return abs(a - b) < 1.0e-9;
}

fn main() -> i64 {
    let iunit: Complex = complex_new(0.0, 1.0);

    // sin(i) = i*sinh(1)
    let si: Complex = complex_sin(iunit);
    assert close(si.re, 0.0);
    assert close(si.im, sinh(1.0));

    // cos(i) = cosh(1)
    let ci: Complex = complex_cos(iunit);
    assert close(ci.re, cosh(1.0));
    assert close(ci.im, 0.0);

    // sinh(i) = i*sin(1)
    let shi: Complex = complex_sinh(iunit);
    assert close(shi.re, 0.0);
    assert close(shi.im, sin(1.0));

    // cosh(i) = cos(1)
    let chi: Complex = complex_cosh(iunit);
    assert close(chi.re, cos(1.0));
    assert close(chi.im, 0.0);

    // On the real axis, complex trig functions must match the real builtins.
    let real5: Complex = complex_new(0.5, 0.0);
    let sin5: Complex = complex_sin(real5);
    assert close(sin5.re, sin(0.5));
    assert close(sin5.im, 0.0);
    let cos5: Complex = complex_cos(real5);
    assert close(cos5.re, cos(0.5));
    assert close(cos5.im, 0.0);
    let tan5: Complex = complex_tan(real5);
    assert close(tan5.re, tan(0.5));
    assert close(tan5.im, 0.0);
    let sinh5: Complex = complex_sinh(real5);
    assert close(sinh5.re, sinh(0.5));
    assert close(sinh5.im, 0.0);
    let cosh5: Complex = complex_cosh(real5);
    assert close(cosh5.re, cosh(0.5));
    assert close(cosh5.im, 0.0);
    let tanh5: Complex = complex_tanh(real5);
    assert close(tanh5.re, tanh(0.5));
    assert close(tanh5.im, 0.0);

    // Pythagorean-style identity: sin(z)^2 + cos(z)^2 = 1 for a general
    // (non-real) z.
    let z: Complex = complex_new(0.7, 1.3);
    let sinz: Complex = complex_sin(z);
    let cosz: Complex = complex_cos(z);
    let sin2: Complex = complex_mul(sinz, sinz);
    let cos2: Complex = complex_mul(cosz, cosz);
    let ident: Complex = complex_add(sin2, cos2);
    assert close(ident.re, 1.0);
    assert close(ident.im, 0.0);

    // Hyperbolic identity: cosh(z)^2 - sinh(z)^2 = 1
    let sinhz: Complex = complex_sinh(z);
    let coshz: Complex = complex_cosh(z);
    let sinh2: Complex = complex_mul(sinhz, sinhz);
    let cosh2: Complex = complex_mul(coshz, coshz);
    let hident: Complex = complex_sub(cosh2, sinh2);
    assert close(hident.re, 1.0);
    assert close(hident.im, 0.0);

    return 0;
}
