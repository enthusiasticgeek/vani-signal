// Synthesizes a signal made of two sine waves (3 Hz and 7 Hz), FFTs it, and
// reports which frequency bins carry most of the energy -- the classic
// "find the tones in a signal" spectral-analysis workflow.
//
// Run with:  vanic run examples/spectrum_demo.vani

use "../src/lib.vani";

fn main() -> i64 {
    let n: i64 = 32;
    let sample_rate: f64 = 32.0;
    let pi: f64 = f64_pi();

    let signal: Vec<f64> = vec();
    let i: i64 = 0;
    while i < n {
        let t: f64 = (i as f64) / sample_rate;
        let v: f64 = sin(2.0 * pi * 3.0 * t) + 0.5 * sin(2.0 * pi * 7.0 * t);
        push(mut ref signal, v);
        i = i + 1;
    }

    // n is already a power of two (32), so fft_real applies directly --
    // otherwise next_power_of_two()/zero_pad() would prepare it first.
    let spectrum: Vec<Complex> = fft_real(ref signal);
    let mag: Vec<f64> = dft_magnitude(ref spectrum);
    let freqs: Vec<f64> = fft_freq(n, sample_rate);

    print "bin : frequency (Hz) : magnitude";
    i = 0;
    while i < n / 2 {
        if mag[i] > 1.0 {
            print i;
            print freqs[i];
            print mag[i];
        }
        i = i + 1;
    }

    return 0;
}
