// Tests for numeric Laplace/Z transforms, including a composed cross-check
// that z_transform_numeric on the unit circle matches dft() -- both are the
// same sum, so a sign/orientation mismatch between the two implementations
// would only show up when they're compared against each other, not in
// isolation.
// Run with:  vanic test tests/test_transforms.vani

use "../src/lib.vani";

fn close(a: f64, b: f64) -> bool {
    return abs(a - b) < 1.0e-6;
}

fn main() -> i64 {
    // z_transform_numeric([1,1,1,1], z=2) = 1 + 0.5 + 0.25 + 0.125 = 1.875.
    let ones: Vec<f64> = vec();
    push(mut ref ones, 1.0); push(mut ref ones, 1.0); push(mut ref ones, 1.0); push(mut ref ones, 1.0);
    let z: complex::Complex = complex::complex_new(2.0, 0.0);
    let zres: complex::Complex = z_transform_numeric(ref ones, z);
    assert close(zres.re, 1.875);
    assert close(zres.im, 0.0);

    // Composed cross-check: evaluating the Z-transform on the unit circle at
    // angle 2*pi*k/n must equal dft(x)[k], for every bin k.
    let x: Vec<f64> = vec();
    push(mut ref x, 1.0); push(mut ref x, 2.0); push(mut ref x, 3.0); push(mut ref x, 4.0);
    let xc: Vec<complex::Complex> = vec();
    push(mut ref xc, complex::complex_new(1.0, 0.0));
    push(mut ref xc, complex::complex_new(2.0, 0.0));
    push(mut ref xc, complex::complex_new(3.0, 0.0));
    push(mut ref xc, complex::complex_new(4.0, 0.0));
    let spectrum: Vec<complex::Complex> = dft(ref xc);
    let pi: f64 = f64_pi();
    let n: i64 = 4;
    let k: i64 = 0;
    while k < n {
        let angle: f64 = 2.0 * pi * (k as f64) / (n as f64);
        let zk: complex::Complex = complex::complex_from_polar(1.0, angle);
        let zt: complex::Complex = z_transform_numeric(ref x, zk);
        assert close(zt.re, spectrum[k].re);
        assert close(zt.im, spectrum[k].im);
        k = k + 1;
    }

    // Composed round-trip check: sample X(z) = z_transform_numeric(x, .)
    // on a circle of radius r, then z_transform_inverse must recover x
    // exactly (up to floating error) -- both the unit-circle case (r=1,
    // the ordinary IDFT) and a non-trivial radius (r=2, exercising the
    // r^n rescaling).
    let r1: f64 = 1.0;
    let samples1: Vec<complex::Complex> = vec();
    k = 0;
    while k < n {
        let angle1: f64 = 2.0 * pi * (k as f64) / (n as f64);
        let zk1: complex::Complex = complex::complex_from_polar(r1, angle1);
        push(mut ref samples1, z_transform_numeric(ref x, zk1));
        k = k + 1;
    }
    let recovered1: Vec<f64> = z_transform_inverse(ref samples1, r1);
    k = 0;
    while k < n {
        assert close(recovered1[k], x[k]);
        k = k + 1;
    }

    let r2: f64 = 2.0;
    let samples2: Vec<complex::Complex> = vec();
    k = 0;
    while k < n {
        let angle2: f64 = 2.0 * pi * (k as f64) / (n as f64);
        let zk2: complex::Complex = complex::complex_from_polar(r2, angle2);
        push(mut ref samples2, z_transform_numeric(ref x, zk2));
        k = k + 1;
    }
    let recovered2: Vec<f64> = z_transform_inverse(ref samples2, r2);
    k = 0;
    while k < n {
        assert close(recovered2[k], x[k]);
        k = k + 1;
    }

    // laplace_transform_numeric of e^(-2t), finely sampled on [0, 20], at
    // s=3 should approximate the textbook closed form 1/(s+2) = 0.2. Finite
    // upper limit + trapezoidal rule -> loose tolerance.
    let tvec: Vec<f64> = vec();
    let xvec: Vec<f64> = vec();
    let steps: i64 = 4000;
    let tmax: f64 = 20.0;
    let i: i64 = 0;
    while i <= steps {
        let tt: f64 = tmax * (i as f64) / (steps as f64);
        push(mut ref tvec, tt);
        push(mut ref xvec, exp((0.0 - 2.0) * tt));
        i = i + 1;
    }
    let s: complex::Complex = complex::complex_new(3.0, 0.0);
    let lres: complex::Complex = laplace_transform_numeric(ref tvec, ref xvec, s);
    assert abs(lres.re - 0.2) < 1.0e-3;
    assert abs(lres.im) < 1.0e-3;

    // A second closed form: L{1}(s) = 1/s for the constant signal x(t)=1,
    // at s=4 -> expect 0.25.
    let tvec2: Vec<f64> = vec();
    let xvec2: Vec<f64> = vec();
    i = 0;
    while i <= steps {
        let tt2: f64 = tmax * (i as f64) / (steps as f64);
        push(mut ref tvec2, tt2);
        push(mut ref xvec2, 1.0);
        i = i + 1;
    }
    let s2: complex::Complex = complex::complex_new(4.0, 0.0);
    let lres2: complex::Complex = laplace_transform_numeric(ref tvec2, ref xvec2, s2);
    assert abs(lres2.re - 0.25) < 1.0e-3;
    assert abs(lres2.im) < 1.0e-3;

    return 0;
}
