// Tests for DFT/FFT, spectrum helpers, and padding utilities.
// Run with:  vanic test tests/test_dft_fft.vani

use "../src/lib.vani";

fn close(a: f64, b: f64) -> bool {
    return abs(a - b) < 1.0e-6;
}

fn main() -> i64 {
    // dft([1,1,1,1]) = [4, 0, 0, 0] (DC-only signal).
    let ones: Vec<complex::Complex> = vec();
    push(mut ref ones, complex::complex_new(1.0, 0.0));
    push(mut ref ones, complex::complex_new(1.0, 0.0));
    push(mut ref ones, complex::complex_new(1.0, 0.0));
    push(mut ref ones, complex::complex_new(1.0, 0.0));
    let d1: Vec<complex::Complex> = dft(ref ones);
    assert close(d1[0].re, 4.0);
    assert close(d1[0].im, 0.0);
    assert close(d1[1].re, 0.0);
    assert close(d1[2].re, 0.0);
    assert close(d1[3].re, 0.0);

    // dft([1,2,3,4]) has the textbook closed form [10, -2+2i, -2, -2-2i].
    let x: Vec<complex::Complex> = vec();
    push(mut ref x, complex::complex_new(1.0, 0.0));
    push(mut ref x, complex::complex_new(2.0, 0.0));
    push(mut ref x, complex::complex_new(3.0, 0.0));
    push(mut ref x, complex::complex_new(4.0, 0.0));
    let d2: Vec<complex::Complex> = dft(ref x);
    assert close(d2[0].re, 10.0);
    assert close(d2[0].im, 0.0);
    assert close(d2[1].re, 0.0 - 2.0);
    assert close(d2[1].im, 2.0);
    assert close(d2[2].re, 0.0 - 2.0);
    assert close(d2[2].im, 0.0);
    assert close(d2[3].re, 0.0 - 2.0);
    assert close(d2[3].im, 0.0 - 2.0);

    // fft must agree with dft on the same input (fast path vs reference path).
    let d2_fft: Vec<complex::Complex> = fft(ref x);
    let i: i64 = 0;
    while i < 4 {
        assert close(d2_fft[i].re, d2[i].re);
        assert close(d2_fft[i].im, d2[i].im);
        i = i + 1;
    }

    // idft(dft(x)) round-trips to x.
    let back: Vec<complex::Complex> = idft(ref d2);
    i = 0;
    while i < 4 {
        assert close(back[i].re, x[i].re);
        assert close(back[i].im, 0.0);
        i = i + 1;
    }

    // ifft(fft(x)) round-trips to x too (via the conjugate-trick inverse).
    let back2: Vec<complex::Complex> = ifft(ref d2_fft);
    i = 0;
    while i < 4 {
        assert close(back2[i].re, x[i].re);
        assert close(back2[i].im, 0.0);
        i = i + 1;
    }

    // fft_real([1,2,3,4]) must equal fft of the same values lifted to complex::Complex.
    let xr: Vec<f64> = vec();
    push(mut ref xr, 1.0); push(mut ref xr, 2.0); push(mut ref xr, 3.0); push(mut ref xr, 4.0);
    let d2_real: Vec<complex::Complex> = fft_real(ref xr);
    i = 0;
    while i < 4 {
        assert close(d2_real[i].re, d2[i].re);
        assert close(d2_real[i].im, d2[i].im);
        i = i + 1;
    }

    // Magnitude/power spectra of [1,2,3,4]'s DFT.
    let mag: Vec<f64> = dft_magnitude(ref d2);
    let pow: Vec<f64> = dft_power(ref d2);
    assert close(mag[0], 10.0);
    assert close(pow[0], 100.0);
    // bin 1: -2+2i -> magnitude sqrt(8), power 8.
    assert close(mag[1], sqrt(8.0));
    assert close(pow[1], 8.0);

    // fft_freq(4, 8.0) = [0, 2, -4, -2] (sample_rate=8Hz, n=4).
    let fr: Vec<f64> = fft_freq(4, 8.0);
    assert close(fr[0], 0.0);
    assert close(fr[1], 2.0);
    assert close(fr[2], 0.0 - 4.0);
    assert close(fr[3], 0.0 - 2.0);

    // next_power_of_two.
    assert next_power_of_two(1) == 1;
    assert next_power_of_two(2) == 2;
    assert next_power_of_two(5) == 8;
    assert next_power_of_two(9) == 16;

    // zero_pad([1,2,3], 5) = [1,2,3,0,0]; fft-ready length after padding.
    let short: Vec<f64> = vec();
    push(mut ref short, 1.0); push(mut ref short, 2.0); push(mut ref short, 3.0);
    let padded: Vec<f64> = zero_pad(ref short, 5);
    assert close(padded[0], 1.0);
    assert close(padded[1], 2.0);
    assert close(padded[2], 3.0);
    assert close(padded[3], 0.0);
    assert close(padded[4], 0.0);
    let padded_pow2: Vec<f64> = zero_pad(ref short, next_power_of_two(3));
    let spec: Vec<complex::Complex> = fft_real(ref padded_pow2);
    assert (len(ref spec) as i64) == 4;

    // zero_pad_complex mirrors zero_pad for Vec<complex::Complex>.
    let cshort: Vec<complex::Complex> = vec();
    push(mut ref cshort, complex::complex_new(1.0, 0.0));
    push(mut ref cshort, complex::complex_new(2.0, 0.0));
    let cpadded: Vec<complex::Complex> = zero_pad_complex(ref cshort, 4);
    assert close(cpadded[0].re, 1.0);
    assert close(cpadded[1].re, 2.0);
    assert close(cpadded[2].re, 0.0);
    assert close(cpadded[3].re, 0.0);

    return 0;
}
